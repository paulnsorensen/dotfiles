[Unit]
Description=Dotfiles credential broker for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PYTHON__ __LIBEXEC__/agent-secret-broker.py --mode broker --policy __POLICY__ --socket __REQUEST_SOCKET__ --control-socket __CONTROL_SOCKET__ --run-user __SERVICE_USER__ --upstream-home __STATE_DIR__
Restart=on-failure
RestartSec=2s
RuntimeDirectory=dotfiles-agent-secrets
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=__POLICY__
ReadWritePaths=/var/run/dotfiles-agent-secrets __STATE_DIR__
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

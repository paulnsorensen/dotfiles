# bin-doctor allowlist — installs that `bin-doctor check` accepts although
# neither packages.yaml nor the mise manifest declares them.
#
# Format: <kind>:<name>  # reason
# <kind> is brew, cargo, uv, npm, or shadow. Every line needs a reason.

# Bootstrap trust roots (see [[operations/brew-machine-prune]]).
brew:mise                                # brew installs mise before sync_mise runs
brew:rustup                              # mise's rust entry delegates toolchains to rustup
brew:yq                                  # macOS bootstrap installs brew yq before mise (packages/sync.sh)

# Own-authored nightly channels, installed by chezmoi run_after scripts (ADR-006).
npm:@paulnsorensen/tilth-nightly
npm:@paulnsorensen/hallouminate-nightly

# Accepted-unmanaged boundary on the macOS work machine; work projects need
# these (see [[operations/brew-machine-prune]]).
brew:docker
brew:docker-compose
brew:colima
brew:kubernetes-cli
brew:yarn
brew:biome
brew:postgresql@15
brew:redis
brew:temporal
brew:python@3.12
brew:poppler
brew:yamlfmt
brew:yamllint
brew:yabai
brew:helm
brew:opa
brew:opentofu
brew:signadot-cli
shadow:node                              # the multiplier overlay loads nvm for work projects; mise node wins PATH
shadow:npm                               # nvm's node ships npm too; mise node wins PATH
shadow:yarn                              # nvm's node ships yarn beside the allowlisted brew yarn
shadow:yarnpkg                           # same pair as yarn

# Copies that another install requires and cannot drop.
shadow:claude                            # cmux.app bundles its own claude; the mise pin wins PATH
shadow:protoc                            # brew protobuf is a mosh dependency; the mise pin wins PATH
shadow:rust-analyzer                     # brew rustup always ships a proxy; the mise pin wins PATH

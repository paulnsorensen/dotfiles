# Brownfield - Ghostty/cmux configuration
# Generated by theme/generate.sh from theme/schemes/brownfield-warm.yaml
# DO NOT EDIT - changes will be overwritten on next `dots sync`

# Font (matches iTerm2 profile)
font-family = Hack Nerd Font Mono
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 14
font-thicken = true
font-thicken-strength = 200

# Core colors
background = #211a16
foreground = #e6dcd6

# Cursor
cursor-color = #e6dcd6
cursor-text = #211a16
cursor-style = block

# Selection
selection-background = #2b231f
selection-foreground = #f8f8f8

# Background image (duck, matches iTerm2)
background-image = __DOTFILES_DIR__/iterm2/background/i_know_how_to_make_ducks.png
background-image-opacity = 0.06
background-image-position = center-left
background-blur = 20

# ANSI palette (0-7: normal, 8-15: bright)
palette = 0=#261f1b
palette = 1=#b69599
palette = 2=#a1cb2d
palette = 3=#f5d710
palette = 4=#799af9
palette = 5=#d36bd1
palette = 6=#99bec2
palette = 7=#e6dcd6
palette = 8=#8b8b8b
palette = 9=#f49c89
palette = 10=#8be46a
palette = 11=#ff7643
palette = 12=#8abcff
palette = 13=#f1b3c5
palette = 14=#10edef
palette = 15=#f8f8f8

# Split panes
unfocused-split-opacity = 0.85
split-divider-color = #2b231f

# Window
window-padding-x = 4
window-padding-y = 4
window-padding-color = background

# Scrollback
scrollback-limit = 10000

# Clipboard (macOS)
copy-on-select = clipboard

# SSH integration: auto-install xterm-ghostty terminfo on remote hosts
# and forward TERM/COLORTERM so ncurses apps render correctly over SSH
shell-integration-features = ssh-terminfo,ssh-env

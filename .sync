#!/usr/bin/env bash
############################
# .sync
# Dotfiles sync orchestrator
############################

set -euo pipefail  # Fail fast on errors
for _sync_secret in \
    GH_TOKEN \
    GITHUB_PERSONAL_ACCESS_TOKEN \
    GITHUB_APP_PRIVATE_KEY \
    CONTEXT7_API_KEY \
    TAVILY_API_KEY \
    SERPER_API_KEY \
    TODOIST_API_KEY; do
    unset "$_sync_secret"
done
unset _sync_secret


########## Variables

dir=$(pwd)
if [[ -n "${DOTFILES_DIR:-}" && "$DOTFILES_DIR" != "$dir" ]]; then
    unset DOTFILES_VAULT_PROVIDER DOTFILES_OP_ITEM BWS_PROJECT_ID
fi
export DOTFILES_DIR="$dir"
olddir=~/.dotfiles.bak             # old dotfiles backup directory

# State management
DOTFILES_STATE_DIR="${HOME}/.local/state/dotfiles"

# Source helpers from the script's own directory. Test harnesses that eval
# this file may override the location via SYNC_SCRIPT.
_sync_script_path="${SYNC_SCRIPT:-${BASH_SOURCE[0]:-}}"
if [[ -n "$_sync_script_path" ]]; then
    _sync_script_dir="$(cd "${_sync_script_path%/*}" && pwd)"
    # shellcheck source=.sync-lib.sh
    [[ -f "$_sync_script_dir/.sync-lib.sh" ]] && source "$_sync_script_dir/.sync-lib.sh"
    unset _sync_script_dir
fi
unset _sync_script_path

########## Functions
verify_harness_versions() {
    local phase="${1:-after package convergence}"
    local omp_version codex_version

    if ! command -v omp >/dev/null 2>&1; then
        log_error "omp unavailable $phase"
        return 1
    fi
    if ! omp_version="$(omp --version)"; then
        log_error "omp --version failed $phase"
        return 1
    fi
    if [[ "$omp_version" != "omp/18.1.12" ]]; then
        log_error "omp version mismatch $phase: expected omp/18.1.12, got $omp_version"
        return 1
    fi

    if ! command -v codex >/dev/null 2>&1; then
        log_error "codex unavailable $phase"
        return 1
    fi
    if ! codex_version="$(codex --version)"; then
        log_error "codex --version failed $phase"
        return 1
    fi
    if [[ "$codex_version" != "codex-cli 0.153.0" ]]; then
        log_error "codex version mismatch $phase: expected codex-cli 0.153.0, got $codex_version"
        return 1
    fi
}


# Record the current sync timestamp
record_sync_time() {
    mkdir -p "${DOTFILES_STATE_DIR}"
    date +%s > "${DOTFILES_STATE_DIR}/last_sync"
}

# Main sync function
run_sync() {
    record_sync_time
    parse_sync_args "$@"

    # Export the package-policy decision before packages/sync.sh runs. Explicit
    # provider intent wins; auto preserves the no-package-churn op-presence rule.
    if [[ -f "$dir/bin/lib/vault.sh" ]]; then
        local vault_gate_status
        # shellcheck source=bin/lib/vault.sh
        source "$dir/bin/lib/vault.sh"
        vault_unset_retired_secrets
        BITWARDEN_DISABLED=false
        if vault_disables_bitwarden_install; then
            BITWARDEN_DISABLED=true
        else
            vault_gate_status=$?
            (( vault_gate_status == 1 )) || return "$vault_gate_status"
        fi
        export BITWARDEN_DISABLED
    fi

    # Bootstrap yq (needed by packages/sync.sh to parse YAML)
    if [[ "$(uname)" == "Darwin" ]] && ! command -v yq &>/dev/null; then
      log_info "Bootstrapping yq..."
      brew install yq
    fi

    if ! command -v chezmoi &>/dev/null; then
        log_info "Bootstrapping mise-managed chezmoi before initial apply"
        PACKAGES_BOOTSTRAP_ONLY=true \
            MISE_CONFIG_FILE="$dir/chezmoi/dot_config/mise/config.toml" \
            FORCE_PACKAGES=true \
            bash "$dir/packages/sync.sh"
        export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
        hash -r 2>/dev/null || true
        if ! command -v chezmoi &>/dev/null; then
            log_error "chezmoi unavailable after package bootstrap"
            exit 1
        fi
    fi

    log_info "Creating $olddir for backup of any existing dotfiles in ~"
    mkdir -p "$olddir"

    for file in *; do
        if [[ "$file" == "chezmoi" ]]; then
            CHEZMOI_SYNC_PHASE=prepare sync_entry "$file"
        else
            sync_entry "$file"
        fi
    done
    sync_hidden_dirs

    # The prepare phase wires chezmoi without applying generated config.
    # Converge against the tracked source manifest before the final cutover.
    log_info "Syncing packages"
    MISE_CONFIG_FILE="$dir/chezmoi/dot_config/mise/config.toml" \
        bash "$dir/packages/sync.sh"
    export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
    hash -r 2>/dev/null || true

    if [[ -f "$dir/chezmoi/.sync" ]]; then
        if verify_harness_versions; then
            log_info "Applying chezmoi after package convergence"
            if ! CHEZMOI_SYNC_PHASE=final bash "$dir/chezmoi/.sync"; then
                log_error "final chezmoi apply failed; upgraded packages are retained"
                SYNC_FAILURES+=("chezmoi")
            else
                if ! verify_harness_versions "after final chezmoi apply"; then
                    log_error "post-apply harness-version verification failed; upgraded packages are retained"
                    SYNC_FAILURES+=("harness-versions")
                fi
            fi
        else
            log_error "final chezmoi apply skipped; upgraded packages are retained"
            SYNC_FAILURES+=("harness-versions")
        fi
    else
        log_error "final chezmoi runner missing: $dir/chezmoi/.sync"
        SYNC_FAILURES+=("chezmoi")
    fi

    install_tpm
    install_prek_hooks
    install_tilth_claude_code
    reconcile_claude_mcps
    sync_omp_plugins "$dir"

    unset DOTFILES_DEV

    if (( ${#SYNC_FAILURES[@]} > 0 )); then
        echo
        log_error "Sync completed with FAILURES in: ${SYNC_FAILURES[*]}"
        log_error "Configuration is partially applied — those areas may be stale."
        log_error "Re-run 'dots sync' after fixing the underlying cause."
        echo
        log_info "To undo, run: dots rollback"
        exit 1
    fi

    log_success "Sync completed successfully!"
}

# Help message
show_help() {
    echo "Usage: $0 [OPTION]"
    echo
    echo "Options:"
    echo "  (no args)      Run normal sync"
    echo "  dev            Set dev mode"
    echo "  q              Quick sync"
    echo "  refresh        Force re-check all packages (bypass cache)"
    echo "  help           Show this help message"
}

########## Main

case "${1:-sync}" in
    help|--help|-h)
        show_help
        ;;
    *)
        run_sync "$@"
        ;;
esac

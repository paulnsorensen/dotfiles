#!/usr/bin/env bash
############################
# .sync
# Dotfiles sync orchestrator
############################

set -euo pipefail  # Fail fast on errors

########## Variables

dir=$(pwd)
olddir=~/.dotfiles.bak             # old dotfiles backup directory

# State management
DOTFILES_STATE_DIR="${HOME}/.local/state/dotfiles"

# Source helpers from the script's own directory. Test harnesses that eval
# this file may override the location via SYNC_SCRIPT.
_sync_script_path="${SYNC_SCRIPT:-${BASH_SOURCE[0]:-}}"
if [[ -n "$_sync_script_path" ]]; then
    _sync_script_dir="$(cd "${_sync_script_path%/*}" && pwd)"
    # shellcheck source=.sync-lib.sh
    [[ -f "$_sync_script_dir/.sync-lib.sh" ]] && source "$_sync_script_dir/.sync-lib.sh"
    unset _sync_script_dir
fi
unset _sync_script_path

########## Functions

# Record the current sync timestamp
record_sync_time() {
    mkdir -p "${DOTFILES_STATE_DIR}"
    date +%s > "${DOTFILES_STATE_DIR}/last_sync"
}

# Main sync function
run_sync() {
    record_sync_time
    parse_sync_args "$@"

    # Export ONEPASSWORD_PRESENT before packages/sync.sh runs so a 1Password
    # machine's bws gate_unless suppresses installing the Bitwarden CLI.
    if [[ -f "$dir/bin/lib/vault.sh" ]]; then
        # shellcheck source=bin/lib/vault.sh
        source "$dir/bin/lib/vault.sh"
        ONEPASSWORD_PRESENT=false
        [[ "$(vault_detect 2>/dev/null)" == "onepassword" ]] && ONEPASSWORD_PRESENT=true
        export ONEPASSWORD_PRESENT
    fi

    # Bootstrap yq (needed by packages/sync.sh to parse YAML)
    if [[ "$(uname)" == "Darwin" ]] && ! command -v yq &>/dev/null; then
      log_info "Bootstrapping yq..."
      brew install yq
    fi

    if ! command -v chezmoi &>/dev/null; then
        log_info "Bootstrapping mise-managed chezmoi before initial apply"
        PACKAGES_BOOTSTRAP_ONLY=true \
            MISE_CONFIG_FILE="$dir/chezmoi/dot_config/mise/config.toml" \
            FORCE_PACKAGES=true \
            bash "$dir/packages/sync.sh"
        export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
        hash -r 2>/dev/null || true
        if ! command -v chezmoi &>/dev/null; then
            log_error "chezmoi unavailable after package bootstrap"
            exit 1
        fi
    fi

    log_info "Creating $olddir for backup of any existing dotfiles in ~"
    mkdir -p "$olddir"

    for file in *; do
        sync_entry "$file"
    done
    sync_hidden_dirs

    # Chezmoi deploys the mise manifest during the entry loop above. Run the
    # package convergence only after that apply so config-only pin bumps take
    # effect in the same sync.
    log_info "Syncing packages"
    bash "$dir/packages/sync.sh"

    install_tpm
    install_prek_hooks
    install_tilth_claude_code
    materialize_secrets
    reconcile_claude_mcps
    sync_omp_plugins "$dir"

    unset DOTFILES_DEV

    if (( ${#SYNC_FAILURES[@]} > 0 )); then
        echo
        log_error "Sync completed with FAILURES in: ${SYNC_FAILURES[*]}"
        log_error "Configuration is partially applied — those areas may be stale."
        log_error "Re-run 'dots sync' after fixing the underlying cause."
        echo
        log_info "To undo, run: dots rollback"
        exit 1
    fi

    log_success "Sync completed successfully!"
}

# Help message
show_help() {
    echo "Usage: $0 [OPTION]"
    echo
    echo "Options:"
    echo "  (no args)      Run normal sync"
    echo "  dev            Set dev mode"
    echo "  q              Quick sync"
    echo "  refresh        Force re-check all packages (bypass cache)"
    echo "  help           Show this help message"
}

########## Main

case "${1:-sync}" in
    help|--help|-h)
        show_help
        ;;
    *)
        run_sync "$@"
        ;;
esac

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["mise", "custom.regex"],

  "mise": {
    "managerFilePatterns": [
      "/^chezmoi\\/dot_config\\/mise\\/config\\.toml$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update packages.yaml version and revision pins",
      "managerFilePatterns": ["/^packages\\/packages\\.yaml$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+- [^\\n]*(?:version|rev): "(?<currentValue>[^"]+)"'
      ]
    },
    {
      "customType": "regex",
      "description": "Update pinned OMP npm plugins",
      "managerFilePatterns": ["/^chezmoi\\/\\.chezmoidata\\/omp\\.yaml$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+"[^"]+": (?<currentValue>\\S+)'
      ]
    },
    {
      "customType": "regex",
      "description": "Update pinned npx MCP packages in profiles",
      "managerFilePatterns": ["/^profiles\\/[^/]+\\/profile\\.yaml$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+args: \\["-y", "[^"]+@(?<currentValue>[^"]+)"\\]'
      ]
    },
    {
      "customType": "regex",
      "description": "Update pinned secret-broker upstream MCP packages",
      "managerFilePatterns": ["/^bin\\/vault-provision$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+install_consumer \\S+ \\S+ "\\$npx_path" -y \\S+@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'
      ]
    },
    {
      "customType": "regex",
      "description": "Update the oh-my-pi native installer pin",
      "managerFilePatterns": ["/^packages\\/sync\\.sh$/"],
      "matchStrings": [
        'OMP_PIN="(?<currentValue>[^"]+)"'
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "can1357/oh-my-pi"
    },
    {
      "customType": "regex",
      "description": "Keep the .sync OMP verification guard in lockstep with the installer pin",
      "managerFilePatterns": ["/^\\.sync$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        '!= "omp/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
        'expected omp/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "can1357/oh-my-pi",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],

  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "ignoreTests": false,
  "platformAutomerge": false,

  "packageRules": [
    {
      "description": "Automerge patch and minor updates after CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Fast-moving agent tooling: shorten the soak so pins do not trail by days",
      "matchDepNames": [
        "aqua:anthropics/claude-code",
        "aqua:openai/codex",
        "aqua:rtk-ai/rtk",
        "can1357/oh-my-pi",
        "@playwright/mcp",
        "@agentclientprotocol/codex-acp",
        "@sysid/pi-vim",
        "@upstash/context7-mcp",
        "tavily-mcp",
        "tavily-cli"
      ],
      "minimumReleaseAge": "4 hours"
    },
    {
      "description": "Bump the oh-my-pi installer pin and the .sync guard together in one PR",
      "matchDepNames": ["can1357/oh-my-pi"],
      "groupName": "oh-my-pi"
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}

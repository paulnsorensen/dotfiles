{
  "name": "Chocolate Donut 2",
  "type": "dark",
  "colors": {
    "foreground": "#e3dcd8",
    "descriptionForeground": "#b8b4b2",
    "icon.foreground": "#b8b4b2",
    "focusBorder": "#7191bd80",
    "selection.background": "#2c272380",
    "textLink.foreground": "#60a2f9",
    "textLink.activeForeground": "#99bec2",

    "editor.background": "#221d1a",
    "editor.foreground": "#e3dcd8",
    "editor.lineHighlightBackground": "#27221f",
    "editor.selectionBackground": "#2c272380",
    "editorCursor.foreground": "#d7aa26",
    "editorLineNumber.foreground": "#8e8e8e",
    "editorLineNumber.activeForeground": "#e3dcd8",
    "editorError.foreground": "#ee6a25",
    "editorWarning.foreground": "#d7aa26",
    "editorInfo.foreground": "#99bec2",
    "editorGutter.addedBackground": "#26c694",
    "editorGutter.modifiedBackground": "#60a2f9",
    "editorGutter.deletedBackground": "#ee6a25",
    "editorWidget.background": "#1d1815",
    "editorWidget.border": "#2c2723",

    "sideBar.background": "#1d1815",
    "sideBar.foreground": "#b8b4b2",
    "sideBar.border": "#2c2723",
    "activityBar.background": "#191411",
    "activityBar.foreground": "#e3dcd8",
    "activityBar.inactiveForeground": "#8e8e8e",
    "statusBar.background": "#191411",
    "statusBar.foreground": "#b8b4b2",
    "titleBar.activeBackground": "#191411",
    "titleBar.activeForeground": "#e3dcd8",
    "tab.activeBackground": "#221d1a",
    "tab.activeForeground": "#f8f8f8",
    "tab.inactiveBackground": "#1d1815",
    "tab.inactiveForeground": "#b8b4b2",
    "panel.background": "#1d1815",
    "panel.border": "#2c2723",

    "list.activeSelectionBackground": "#2c2723",
    "list.activeSelectionForeground": "#f8f8f8",
    "list.hoverBackground": "#27221f",
    "list.highlightForeground": "#d7aa26",

    "button.background": "#7191bd",
    "button.foreground": "#191411",
    "button.hoverBackground": "#60a2f9",
    "button.secondaryBackground": "#2c2723",
    "button.secondaryForeground": "#e3dcd8",
    "badge.background": "#d7aa26",
    "badge.foreground": "#191411",
    "input.background": "#1d1815",
    "input.foreground": "#e3dcd8",
    "input.border": "#2c2723",
    "input.placeholderForeground": "#8e8e8e",
    "dropdown.background": "#1d1815",
    "dropdown.foreground": "#e3dcd8",
    "dropdown.border": "#2c2723",
    "progressBar.background": "#d7aa26",

    "gitDecoration.addedResourceForeground": "#26c694",
    "gitDecoration.modifiedResourceForeground": "#60a2f9",
    "gitDecoration.deletedResourceForeground": "#ee6a25",
    "gitDecoration.untrackedResourceForeground": "#8ae369",
    "gitDecoration.conflictingResourceForeground": "#d7aa26",
    "diffEditor.insertedTextBackground": "#26c69426",
    "diffEditor.removedTextBackground": "#ee6a2526",

    "terminal.background": "#221d1a",
    "terminal.foreground": "#e3dcd8",
    "terminal.ansiBlack": "#27221f",
    "terminal.ansiRed": "#ee6a25",
    "terminal.ansiGreen": "#26c694",
    "terminal.ansiYellow": "#d7aa26",
    "terminal.ansiBlue": "#7191bd",
    "terminal.ansiMagenta": "#e47be2",
    "terminal.ansiCyan": "#99bec2",
    "terminal.ansiWhite": "#e3dcd8",
    "terminal.ansiBrightBlack": "#8e8e8e",
    "terminal.ansiBrightRed": "#e69572",
    "terminal.ansiBrightGreen": "#8ae369",
    "terminal.ansiBrightYellow": "#f6cfa0",
    "terminal.ansiBrightBlue": "#60a2f9",
    "terminal.ansiBrightMagenta": "#dfb3fb",
    "terminal.ansiBrightCyan": "#9ce5f4",
    "terminal.ansiBrightWhite": "#f8f8f8",
    "terminalCursor.foreground": "#d7aa26"
  },
  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8e8e8e", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string"], "settings": { "foreground": "#26c694" } },
    { "name": "Numbers and constants", "scope": ["constant", "constant.numeric"], "settings": { "foreground": "#f6cfa0" } },
    { "name": "Keywords and storage", "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#e47be2" } },
    { "name": "Functions", "scope": ["entity.name.function", "meta.function-call", "support.function"], "settings": { "foreground": "#7191bd" } },
    { "name": "Types and classes", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#d7aa26" } },
    { "name": "Variables", "scope": ["variable", "variable.other"], "settings": { "foreground": "#e3dcd8" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#ee6a25" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#b8b4b2" } },
    { "name": "Regex and escapes", "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#99bec2" } },
    { "name": "Markdown headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#d7aa26", "fontStyle": "bold" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#26c694" } },
    { "name": "Markdown links", "scope": ["markup.underline.link"], "settings": { "foreground": "#60a2f9" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#26c694" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#ee6a25" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#60a2f9" } }
  ]
}

#!/usr/bin/env bash
# Provision agent-secret service identities and their per-consumer credentials.
# Secret values are captured only in memory and streamed to a privileged writer;
# this command never prints them, creates a user cache, or writes a Linux token.
set -euo pipefail

DOTFILES_DIR="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)"
DESTDIR="${DESTDIR:-}"
DESTDIR="${DESTDIR%/}"
SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
# shellcheck source=lib/vault.sh
source "$SCRIPT_DIR/lib/vault.sh"
vault_load_settings "$DOTFILES_DIR/.env"

usage() {
    cat >&2 <<'EOF'
Usage: vault-provision [--request-user USER] [--operator-user USER]

Resolve the configured vault provider and install service-owned credentials and
policies for context7, tavily, and todoist. Secret values are never
printed, stored in a daily-user cache, or exposed to agent processes.
EOF
}

request_user="${SUDO_USER:-${USER:-}}"
operator_user=root
while (( $# > 0 )); do
    case "$1" in
        --request-user)
            (( $# >= 2 )) || { usage; exit 2; }
            request_user="$2"
            shift 2
            ;;
        --operator-user)
            (( $# >= 2 )) || { usage; exit 2; }
            operator_user="$2"
            shift 2
            ;;
        -h|--help)
            usage >&1
            exit 0
            ;;
        *)
            echo "vault-provision: unknown argument '$1'." >&2
            usage
            exit 2
            ;;
    esac
done

[[ -n "$request_user" && -n "$operator_user" ]] || {
    echo "vault-provision: request and operator users are required." >&2
    exit 2
}
[[ "$(id -u "$request_user")" != "$(id -u "$operator_user")" ]] || {
    echo "vault-provision: request and operator users must be distinct." >&2
    exit 2
}

provider="$(vault_resolve)" || exit $?
[[ "$provider" != unconfigured ]] || {
    echo "vault-provision: no vault provider is ready; configure .env or run the provider login first." >&2
    exit 1
}

installer="$DOTFILES_DIR/bin/agent-secret-install"
[[ -x "$installer" ]] || {
    echo "vault-provision: missing executable $installer." >&2
    exit 1
}

if [[ -z "$DESTDIR" && $EUID -ne 0 ]]; then
    sudo_bin="$(type -P sudo || true)"
    [[ -n "$sudo_bin" ]] || {
        echo "vault-provision: root or sudo is required to install service-owned credentials." >&2
        exit 1
    }
else
    sudo_bin=""
fi

run_privileged() {
    if [[ -n "$DESTDIR" || $EUID -eq 0 ]]; then
        "$@"
    else
        "$sudo_bin" "$@"
    fi
}

install_node_runtime() {
    local source_npx="$1" source_bin source_root version destination target chown_path
    local wrapper temporary
    source_bin="${source_npx%/*}"
    source_root="${source_bin%/bin}"
    [[ -x "$source_bin/node" && -f "$source_root/lib/node_modules/npm/bin/npx-cli.js" ]] || {
        echo "vault-provision: npx and node must come from one complete Node installation." >&2
        return 1
    }
    version="$("$source_bin/node" --version)"
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
        echo "vault-provision: node returned an invalid version '$version'." >&2
        return 1
    }
    destination="/usr/local/libexec/dotfiles/node-${version#v}"
    target="$DESTDIR$destination"
    if [[ ! -x "$target/bin/node" || ! -f "$target/lib/node_modules/npm/bin/npx-cli.js" ]]; then
        run_privileged /usr/bin/install -d -m 0755 "$target"
        run_privileged /bin/cp -RL "$source_root/." "$target/"
    fi
    if [[ -z "$DESTDIR" ]]; then
        for chown_path in /usr/bin/chown /usr/sbin/chown /bin/chown; do
            [[ -x "$chown_path" ]] && break
        done
        [[ -x "$chown_path" ]] || {
            echo "vault-provision: chown not found." >&2
            return 1
        }
        run_privileged "$chown_path" -hR 0:0 "$target"
    fi
    run_privileged /bin/chmod -R go-w "$target"

    wrapper="$destination/bin/agent-secret-npx"
    temporary="$(mktemp)"
    printf '#!/bin/sh\nexec %s/bin/node %s/lib/node_modules/npm/bin/npx-cli.js \"$@\"\n' \
        "$destination" "$destination" > "$temporary"
    if [[ -n "$DESTDIR" ]]; then
        /usr/bin/install -m 0755 "$temporary" "$DESTDIR$wrapper"
    else
        run_privileged /usr/bin/install -o root -g 0 -m 0755 "$temporary" "$wrapper"
    fi
    rm -f "$temporary"
    NODE_RUNTIME_NPX="$wrapper"
}

write_privileged_value() {
    local value="$1" path="$2"
    # tee receives the value on stdin; it is never an argument, log line, or
    # environment variable of the installer/broker.
    if [[ -n "$DESTDIR" || $EUID -eq 0 ]]; then
        printf '%s\n' "$value" | /usr/bin/tee "$path" >/dev/null
        /bin/chmod 600 "$path"
    else
        printf '%s\n' "$value" | "$sudo_bin" /usr/bin/tee "$path" >/dev/null
        "$sudo_bin" /bin/chmod 600 "$path"
    fi
}

ensure_bitwarden_value() {
    local key="$1" project_id token value
    if value="$(vault_secret_value bitwarden "$key" 2>/dev/null)"; then
        VAULT_PROVISION_VALUE="$value"
        return 0
    fi
    token="$(_vault_token)" || return 1
    project_id="$(_vault_project_id)" || return 1
    printf 'Enter %s (input hidden): ' "$key" >&2
    IFS= read -r -s value
    printf '\n' >&2
    [[ -n "$value" ]] || {
        echo "vault-provision: refusing an empty value for $key." >&2
        return 1
    }
    # bws output is suppressed; the value is passed only to the provider CLI.
    BWS_ACCESS_TOKEN="$token" bws secret create "$key" "$value" "$project_id" -o json >/dev/null
    VAULT_PROVISION_VALUE="$value"
}

read_provider_value() {
    local key="$1"
    VAULT_PROVISION_VALUE=""
    if [[ "$provider" == bitwarden ]]; then
        ensure_bitwarden_value "$key"
    else
        VAULT_PROVISION_VALUE="$(vault_secret_value "$provider" "$key")"
    fi
    [[ -n "$VAULT_PROVISION_VALUE" ]] || {
        echo "vault-provision: provider returned an empty value for $key." >&2
        return 1
    }
}

install_consumer() {
    local consumer="$1" key="$2"
    shift 2
    local credential_path="/etc/dotfiles/agent-secret/credentials/${consumer}.credential"
    local value
    local -a tool_flags=()
    case "$consumer" in
        context7)
            tool_flags=(
                --read-tool resolve-library-id
                --read-tool query-docs
            )
            ;;
        tavily)
            tool_flags=(
                --read-tool tavily_search
                --read-tool tavily_extract
            )
            ;;
        todoist)
            tool_flags=(
                --read-tool find-activity
                --read-tool find-comments
                --read-tool find-completed-tasks
                --read-tool find-filters
                --read-tool find-labels
                --read-tool find-project-collaborators
                --read-tool find-projects
                --read-tool find-reminders
                --read-tool find-sections
                --read-tool find-tasks
                --read-tool find-tasks-by-date
                --read-tool get-overview
                --read-tool get-productivity-stats
                --read-tool get-project-activity-stats
                --read-tool get-project-health
                --read-tool get-workspace-insights
                --read-tool analyze-project-health
                --read-tool export-project-template
                --read-tool fetch
                --read-tool fetch-object
                --read-tool list-workspaces
                --read-tool search
                --read-tool user-info
                --read-tool view-attachment
                --write-tool add-comments
                --write-tool add-filters
                --write-tool add-labels
                --write-tool add-projects
                --write-tool add-reminders
                --write-tool add-sections
                --write-tool add-tasks
                --write-tool complete-tasks
                --write-tool delete-object
                --write-tool import-project-template
                --write-tool manage-assignments
                --write-tool project-management
                --write-tool project-move
                --write-tool reorder-objects
                --write-tool reschedule-tasks
                --write-tool uncomplete-tasks
                --write-tool update-comments
                --write-tool update-filters
                --write-tool update-labels
                --write-tool update-projects
                --write-tool update-reminders
                --write-tool update-sections
                --write-tool update-tasks
            )
            ;;
        *) echo "vault-provision: unsupported consumer '$consumer'." >&2; return 2 ;;
    esac

    read_provider_value "$key"
    value="$VAULT_PROVISION_VALUE"
    if [[ -n "$DESTDIR" ]]; then
        /usr/bin/install -d -m 700 "$DESTDIR/etc/dotfiles/agent-secret/credentials"
    else
        run_privileged /usr/bin/install -d -o root -g 0 -m 700 \
            /etc/dotfiles/agent-secret/credentials
    fi
    write_privileged_value "$value" "$DESTDIR$credential_path"

    local -a command=(
        "$installer" install "$consumer"
        --request-user "$request_user"
        --operator-user "$operator_user"
        --credential-env "$key"
        --credential-file "$credential_path"
        "${tool_flags[@]}"
        -- "$@"
    )
    if [[ -n "$DESTDIR" ]]; then
        DESTDIR="$DESTDIR" "${command[@]}"
    else
        run_privileged "${command[@]}"
    fi
    unset value VAULT_PROVISION_VALUE
}

npx_path="$(command -v npx 2>/dev/null)" || {
    echo "vault-provision: npx is required to install local MCP consumers." >&2
    exit 1
}
[[ "$npx_path" == /* ]] || {
    echo "vault-provision: npx did not resolve to an absolute path." >&2
    exit 1
}
install_node_runtime "$npx_path"
npx_path="$NODE_RUNTIME_NPX"
# renovate: datasource=npm depName=@upstash/context7-mcp
install_consumer context7 CONTEXT7_API_KEY "$npx_path" -y @upstash/context7-mcp@3.2.5
# renovate: datasource=npm depName=tavily-mcp
install_consumer tavily TAVILY_API_KEY "$npx_path" -y tavily-mcp@0.2.22
# renovate: datasource=npm depName=@doist/todoist-mcp
install_consumer todoist TODOIST_API_KEY "$npx_path" -y @doist/todoist-mcp@12.5.0

# Record non-secret provider provenance for operators; policy files remain the
# broker's exact schema and contain no provider values.
metadata_path="/etc/dotfiles/agent-secret/provider.json"
metadata="$(printf '{"provider":"%s","source":"%s"}\n' "$provider" "$(vault_source "$provider")")"
write_privileged_value "$metadata" "$DESTDIR$metadata_path"
unset metadata metadata_path provider request_user operator_user sudo_bin npx_path

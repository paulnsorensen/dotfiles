#!/usr/bin/env bash
# cc-env-exec — load the documented non-secret .env allowlist, clear retired
# secret names, then exec the requested command. Values are parsed as data; the
# file is never sourced and no vault cache is consulted.
set -euo pipefail

if (( $# == 0 )); then
    echo "Usage: cc-env-exec <command> [args...]" >&2
    exit 2
fi

# Clear the retired names before any child inherits this process, even if the
# vault library is unavailable in a damaged checkout.
for _retired_secret in \
    GH_TOKEN \
    GITHUB_PERSONAL_ACCESS_TOKEN \
    GITHUB_APP_PRIVATE_KEY \
    CONTEXT7_API_KEY \
    TAVILY_API_KEY \
    SERPER_API_KEY \
    TODOIST_API_KEY; do
    unset "$_retired_secret"
done
unset _retired_secret

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/Dev/dotfiles}"
env_file="$DOTFILES_DIR/.env"
lib="$DOTFILES_DIR/bin/lib/vault.sh"
if [[ -r "$lib" ]]; then
    # shellcheck source=lib/vault.sh
    source "$lib"
    vault_load_settings "$env_file"
fi

exec "$@"

#!/usr/bin/env bash
# dotsclaude — script form of the zsh `cc` function so Conductor (or any other
# launcher that exec's a path) can use the same preamble wrapping.
#
# Mirrors zsh/claude.zsh:_cc_base() — intentionally without the tmux wrap.
set -euo pipefail

# The clone is the parent of this script's directory unless DOTFILES_DIR is
# set. The export lets cc-env-exec read the .env file of the same clone.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export DOTFILES_DIR
AGENTS_DOTFILES="${AGENTS_DOTFILES:-$DOTFILES_DIR/agents}"
CLAUDE_BIN="${CLAUDE_BIN:-${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/claude}"

flags=()

# Preamble system-prompt replacement (replaces Anthropic's baked prompt).
[[ -f "$AGENTS_DOTFILES/preamble.md" ]] && \
    flags+=(--system-prompt-file "$AGENTS_DOTFILES/preamble.md")

# Fresh .env keys at process start (mirrors _cc_base's launcher prefix) —
# Conductor doesn't source zsh init, so .env keys may be absent from its env.
launcher="$DOTFILES_DIR/bin/cc-env-exec"
# ${flags[@]+…} guard: bash 3.2 (macOS /bin/bash) treats an empty array
# expansion as unbound under `set -u`.
if [[ -x "$launcher" ]]; then
    exec "$launcher" "$CLAUDE_BIN" ${flags[@]+"${flags[@]}"} "$@"
fi
exec "$CLAUDE_BIN" ${flags[@]+"${flags[@]}"} "$@"

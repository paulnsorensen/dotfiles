#!/usr/bin/env bash
# dotsclaude — the Claude launch assembly: the system prompt (the tilth
# preamble, then agents/preamble.md) and the cc-env-exec prefix. Launchers
# that exec a path use it (T3 Code, Conductor). The zsh `cc` function runs it
# inside its tmux wrap.
set -euo pipefail

# The clone is the parent of this script's directory unless DOTFILES_DIR is
# set. The export lets cc-env-exec read the .env file of the same clone.
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/preamble-wrappers.sh
source "$SCRIPT_DIR/lib/preamble-wrappers.sh"
DOTFILES_DIR="${DOTFILES_DIR:-${SCRIPT_DIR%/bin}}"
export DOTFILES_DIR
AGENTS_DOTFILES="${AGENTS_DOTFILES:-$DOTFILES_DIR/agents}"
CLAUDE_BIN="${CLAUDE_BIN:-${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/claude}"

flags=()

# Preamble system-prompt replacement (replaces Anthropic's baked prompt):
# the tilth preamble, then agents/preamble.md.
if preamble=$(dots_preamble_file "$AGENTS_DOTFILES/preamble.md"); then
    flags+=(--system-prompt-file "$preamble")
fi

# Fresh .env keys at process start. Conductor doesn't source zsh init, so
# .env keys may be absent from its env.
launcher="$DOTFILES_DIR/bin/cc-env-exec"
# ${flags[@]+…} guard: bash 3.2 (macOS /bin/bash) treats an empty array
# expansion as unbound under `set -u`.
if [[ -x "$launcher" ]]; then
    exec "$launcher" "$CLAUDE_BIN" ${flags[@]+"${flags[@]}"} "$@"
fi
exec "$CLAUDE_BIN" ${flags[@]+"${flags[@]}"} "$@"

#!/usr/bin/env bash
# dotsopencode — run OpenCode with the shared preamble in place of the native
# provider prompts, for launchers that exec a path (T3 Code, Conductor).
# OpenCode counterpart of bin/dotsclaude.
#
# OpenCode has no system-prompt flag. It merges OPENCODE_CONFIG_CONTENT over
# the global config, so this wrapper adds two things there:
#   - work-agent prompts for build, plan, general, and explore. A custom agent
#     prompt replaces the native provider prompt.
#   - the preamble path in `instructions`. OpenCode concatenates this list
#     across sources and drops a repeated path, so the installed path
#     ~/.config/opencode/preamble.md is preferred. It matches the global
#     opencode.json entry and loads once. The clone copy is the fallback.
# The prompts match chezmoi/.chezmoidata/opencode.yaml; tests/dots-wrappers.bats
# asserts this. T3 always sets OPENCODE_CONFIG_CONTENT ("{}" by default); its
# keys win over the keys that this wrapper adds.
set -euo pipefail

AGENTS_DOTFILES="${AGENTS_DOTFILES:-$HOME/Dev/dotfiles/agents}"
OPENCODE_BIN="${OPENCODE_BIN:-${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/opencode}"

if [[ -f "$HOME/.config/opencode/preamble.md" ]]; then
    # Literal tilde: the string must equal the global entry for the dedupe.
    # shellcheck disable=SC2088
    preamble="~/.config/opencode/preamble.md"
elif [[ -f "$AGENTS_DOTFILES/preamble.md" ]]; then
    preamble="$AGENTS_DOTFILES/preamble.md"
else
    exec "$OPENCODE_BIN" "$@"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "dotsopencode: jq missing; native OpenCode prompts stay active" >&2
    exec "$OPENCODE_BIN" "$@"
fi

incoming="${OPENCODE_CONFIG_CONTENT:-}"
[[ -n "$incoming" ]] || incoming='{}'
if ! merged=$(jq -cn --arg preamble "$preamble" --arg incoming "$incoming" '
    ($incoming | fromjson? // error("not JSON")) as $theirs |
    if ($theirs | type) != "object" then error("not an object") else . end |
    "Follow the shared execution preamble and applicable project instructions." as $base |
    {
        instructions: [$preamble],
        agent: {
            build: {prompt: $base},
            plan: {prompt: ($base + " Plan only. Do not change workspace files.")},
            general: {prompt: $base},
            explore: {prompt: ($base + " Read only. Do not change files.")}
        }
    } * $theirs' 2>/dev/null); then
    echo "dotsopencode: OPENCODE_CONFIG_CONTENT is not a JSON object; left unchanged" >&2
    exec "$OPENCODE_BIN" "$@"
fi

export OPENCODE_CONFIG_CONTENT="$merged"
exec "$OPENCODE_BIN" "$@"

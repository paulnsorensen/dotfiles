#!/usr/bin/env bash
# Shim for the t3-run CLI. All logic lives in claude/t3-run/t3-run.mjs.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
done
bin_dir="$(cd -P "$(dirname "$src")" && pwd)"

exec node "$bin_dir/../claude/t3-run/t3-run.mjs" "$@"

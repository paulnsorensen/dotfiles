#!/usr/bin/env bash
set -euo pipefail
BIN_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
LIB="$BIN_DIR/agent-secret-python.sh"
[[ -f "$LIB" ]] || LIB="$BIN_DIR/lib/agent-secret-python.sh"
# shellcheck source=lib/agent-secret-python.sh
source "$LIB"
PYTHON_BIN="$(agent_secret_python_path)" || { echo "tvly-broker: python3 not found" >&2; exit 1; }
PYTHON="$BIN_DIR/agent-secret-client.py"
[[ -f "$PYTHON" ]] || PYTHON="${BIN_DIR%/*}/scripts/agent-secret-client.py"
exec "$PYTHON_BIN" "$PYTHON" --provider tavily "$@"

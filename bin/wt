#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/worktree.sh
source "${SCRIPT_DIR}/lib/worktree.sh"

usage() {
    echo "Usage: wt [-o|-m] <slug>" >&2
    echo "  -o   branch off origin/<default-branch> (fetches first)" >&2
    echo "  -m   branch off the current branch (default)" >&2
    exit 1
}

base_mode="current"
while getopts "om" opt; do
    case "$opt" in
        o) base_mode="origin" ;;
        m) base_mode="current" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

slug="${1:-}"
[[ -z "$slug" ]] && usage

if [[ "$slug" =~ [^a-zA-Z0-9_-] ]]; then
    echo "slug must contain only a-z, 0-9, hyphens, underscores" >&2
    exit 1
fi

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Not a git repository" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
wt_dir="${repo_root}/.worktrees/${slug}"
branch="worktree/${slug}"

created=false
start_point=""
if [[ -d "${wt_dir}" ]]; then
    echo "Resuming worktree: ${wt_dir}" >&2
else
    start_point="$(git -C "${repo_root}" rev-parse --abbrev-ref HEAD)"
    if [[ "$base_mode" == "origin" ]]; then
        git -C "${repo_root}" fetch origin 1>&2 \
            || { echo "wt: git fetch origin failed" >&2; exit 1; }
        default_branch="$(resolve_default_branch "${repo_root}")" || {
            echo "wt: could not resolve origin's default branch" >&2
            exit 1
        }
        start_point="origin/${default_branch}"
    fi
    echo "Creating worktree: ${wt_dir} (branch: ${branch}, from: ${start_point})" >&2
    git -C "${repo_root}" worktree add "${wt_dir}" -b "${branch}" "${start_point}" 1>&2 || exit 1
    created=true
fi

readonly CLAUDE_PROJECTS_DIR="${HOME}/.claude/projects"
main_key="${repo_root//[\/.]/-}"
wt_key="${wt_dir//[\/.]/-}"

if [[ -d "${CLAUDE_PROJECTS_DIR}/${main_key}" ]] && [[ ! -L "${CLAUDE_PROJECTS_DIR}/${wt_key}" ]]; then
    rm -rf "${CLAUDE_PROJECTS_DIR}/${wt_key:?}" 2>/dev/null
    ln -s "${CLAUDE_PROJECTS_DIR}/${main_key}" "${CLAUDE_PROJECTS_DIR}/${wt_key}"
    echo "Linked permissions: ${wt_key} → ${main_key}" >&2
fi

claude_local="${wt_dir}/.claude/settings.local.json"
if [[ ! -f "${claude_local}" ]]; then
    mkdir -p "${wt_dir}/.claude"
    dotfiles_root="${DOTFILES_DIR:-${HOME}/Dev/dotfiles}"
    generator="${dotfiles_root}/claude/worktree-settings.sh"
    tmp="${claude_local}.tmp"

    if [[ -f "${generator}" ]]; then
        if ! bash "${generator}" "${dotfiles_root}" > "${tmp}"; then
            rm -f "${tmp}"
            echo "worktree-settings generator failed for ${dotfiles_root}" >&2
            exit 1
        fi
        mv "${tmp}" "${claude_local}"
        echo "Generated worktree settings ($(jq '.permissions.allow | length' "${claude_local}") permissions)" >&2
    else
        readonly SANDBOX_CONFIG='{"sandbox":{"enabled":true,"autoAllowBashIfSandboxed":true,"filesystem":{"allowWrite":["~/.cache/prek"]}}}'
        if ! echo "$SANDBOX_CONFIG" | jq . > "${tmp}"; then
            rm -f "${tmp}"
            echo "Failed to write sandbox settings" >&2
            exit 1
        fi
        mv "${tmp}" "${claude_local}"
        echo "Created sandbox-only settings" >&2
    fi
fi

base_sha="$(git -C "${wt_dir}" rev-parse --short HEAD)"
if [[ "${created}" == true ]]; then
    base_branch="${start_point}"
else
    base_branch="$(git -C "${repo_root}" rev-parse --abbrev-ref HEAD)"
fi

jq -n \
    --arg path "${wt_dir}" \
    --arg branch "${branch}" \
    --arg base_sha "${base_sha}" \
    --arg base_branch "${base_branch}" \
    --argjson created "${created}" \
    '{path: $path, branch: $branch, base_sha: $base_sha, base_branch: $base_branch, created: $created}'

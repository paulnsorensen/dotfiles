#!/usr/bin/env bash
# Per-file git history risk analysis for the /git-risk skill
# Usage: git-file-risk <file> [file ...]
# Output: JSON array with risk signals per file
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: git-file-risk <file> [file ...]" >&2
    exit 1
fi

SINCE="90 days ago"

file_risk() {
    local file="$1"

    if ! git ls-files --error-unmatch "$file" &>/dev/null 2>&1; then
        jq -nc --arg file "$file" '{file: $file, error: "not tracked"}'
        return
    fi

    local authors changes has_reverts last_change_days staleness

    authors=$(git log --since="$SINCE" --format='%an' -- "$file" 2>/dev/null | sort -u | wc -l | tr -d ' ')
    changes=$(git rev-list --count --since="$SINCE" HEAD -- "$file" 2>/dev/null)
    has_reverts=$(git rev-list --count -i --grep='revert' HEAD -- "$file" 2>/dev/null)

    local last_epoch now_epoch
    last_epoch=$(git log -1 --format='%ct' -- "$file" 2>/dev/null || echo "0")
    now_epoch=$(date +%s)

    if [[ "$last_epoch" -eq 0 ]]; then
        last_change_days=-1
        staleness="unknown"
    else
        last_change_days=$(( (now_epoch - last_epoch) / 86400 ))
        staleness=$(git log -1 --format='%ar' -- "$file" 2>/dev/null)
    fi

    jq -nc --arg file "$file" --arg staleness "$staleness" \
        --argjson authors "$authors" --argjson changes "$changes" \
        --argjson reverts "$has_reverts" --argjson days "$last_change_days" \
        '{file: $file, authors_90d: $authors, changes_90d: $changes, reverts: $reverts, last_change_days: $days, staleness: $staleness}'
}

echo "["
first=true
for file in "$@"; do
    if [[ "$first" == "true" ]]; then
        first=false
    else
        echo ","
    fi
    file_risk "$file"
done
echo "]"

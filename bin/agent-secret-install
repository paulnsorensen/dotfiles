#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)"
DESTDIR="${DESTDIR:-}"
DESTDIR="${DESTDIR%/}"
READ_TOOLS=()
WRITE_TOOLS=()

usage() {
    cat <<'USAGE'
Usage:
  agent-secret-install install CONSUMER --credential-env NAME --credential-file PATH \
      --request-user USER [--operator-user USER] \
      [--read-tool NAME]... [--write-tool NAME]... -- /absolute/upstream [ARG ...]
  agent-secret-install remove CONSUMER

Production installs require root. Set DESTDIR to render and test assets without
activating services or creating service identities. The operator defaults to
root and must be distinct from the request user.
USAGE
}

die() {
    printf 'agent-secret-install: %s\n' "$*" >&2
    exit 2
}

require_root() {
    [[ -n "$DESTDIR" || $EUID -eq 0 ]] || die "production install requires root"
}

validate_consumer() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid consumer: $1"
}

validate_tool() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || die "invalid tool name: $1"
}

resolve_uid() {
    id -u "$1" 2>/dev/null || die "unknown user: $1"
}

resolve_gid() {
    id -g "$1" 2>/dev/null || die "unknown user: $1"
}


python_path() {
    if [[ -x /usr/bin/python3 ]]; then
        printf '%s\n' /usr/bin/python3
        return
    fi
    command -v python3 2>/dev/null || die "python3 not found"
}

credential_is_private() {
    local path="$1" owner mode
    [[ -f "$path" && ! -L "$path" ]] || die "credential file must be a regular non-symlink: $path"
    [[ -n "$DESTDIR" ]] && return
    if [[ "$(uname -s)" == Darwin ]]; then
        owner="$(stat -f '%u' "$path")"
        mode="$(stat -f '%Lp' "$path")"
    else
        owner="$(stat -c '%u' "$path")"
        mode="$(stat -c '%a' "$path")"
    fi
    [[ "$owner" == 0 && "$mode" == 600 ]] \
        || die "credential file must be root-owned mode 0600: $path"
}
trusted_executable() {
    local path="$1" label="$2" owner mode
    [[ -n "$DESTDIR" ]] && return
    [[ -f "$path" && -x "$path" ]] || die "$label is not an executable file: $path"
    # -L: judge the symlink target — /usr/bin/python3 is a symlink on Linux,
    # and an undereferenced stat reports the link's own 0777 mode.
    if [[ "$(uname -s)" == Darwin ]]; then
        owner="$(stat -Lf '%u' "$path")"
        mode="$(stat -Lf '%Lp' "$path")"
    else
        owner="$(stat -Lc '%u' "$path")"
        mode="$(stat -Lc '%a' "$path")"
    fi
    if [[ "$owner" != 0 ]] || (( (8#$mode & 8#22) != 0 )); then
        die "$label must be root-owned and not group/other-writable: $path"
    fi
}


ensure_linux_identity() {
    local service_user="$1" home="$2"
    if getent passwd "$service_user" >/dev/null; then
        return
    fi
    useradd --system --user-group --home-dir "$home" --shell /usr/sbin/nologin "$service_user"
}

ensure_macos_identity() {
    local service_user="$1" home="$2" numeric_id=400
    dscl . -read "/Users/$service_user" >/dev/null 2>&1 && return
    while dscl . -search /Users UniqueID "$numeric_id" | grep -q . \
        || dscl . -search /Groups PrimaryGroupID "$numeric_id" | grep -q .; do
        ((numeric_id++))
        ((numeric_id < 500)) || die "no free macOS service identity ID"
    done
    dscl . -create "/Groups/$service_user"
    dscl . -create "/Groups/$service_user" RealName "Dotfiles agent secret $service_user"
    dscl . -create "/Groups/$service_user" PrimaryGroupID "$numeric_id"
    dscl . -create "/Users/$service_user"
    dscl . -create "/Users/$service_user" RealName "Dotfiles agent secret $service_user"
    dscl . -create "/Users/$service_user" UniqueID "$numeric_id"
    dscl . -create "/Users/$service_user" PrimaryGroupID "$numeric_id"
    dscl . -create "/Users/$service_user" NFSHomeDirectory "$home"
    dscl . -create "/Users/$service_user" UserShell /usr/bin/false
    dscl . -create "/Users/$service_user" IsHidden 1
    dscl . -create "/Users/$service_user" Password '*'
    dscl . -append "/Groups/$service_user" GroupMembership "$service_user"
}

ensure_identity() {
    local platform="$1" service_user="$2" home="$3"
    [[ -n "$DESTDIR" ]] && return
    case "$platform" in
        linux) ensure_linux_identity "$service_user" "$home" ;;
        macos) ensure_macos_identity "$service_user" "$home" ;;
    esac
}

ensure_service_home() {
    local service_user="$1" home="$2"
    local target="$DESTDIR$home"
    if [[ -n "$DESTDIR" ]]; then
        install -d -m 0700 "$target"
    else
        install -d -m 0700 -o "$service_user" -g "$(resolve_gid "$service_user")" "$target"
    fi
}

copy_runtime_tools() {
    local libexec="$DESTDIR/usr/local/libexec/dotfiles"
    install -d -m 0755 "$libexec"
    install -m 0755 "$DOTFILES_DIR/bin/agent-secret-broker" "$libexec/agent-secret-broker"
    install -m 0755 "$DOTFILES_DIR/bin/agent-secret-proxy" "$libexec/agent-secret-proxy"
    install -m 0755 "$DOTFILES_DIR/bin/agent-secretctl" "$libexec/agent-secretctl"
    install -m 0755 "$DOTFILES_DIR/scripts/agent-secret-broker.py" "$libexec/agent-secret-broker.py"
}

render_policy() {
    local destination="$1" consumer="$2" request_uid="$3" operator_uid="$4"
    local credential_env="$5" credential_file="$6"
    shift 6
    local temporary python
    python="$(python_path)"
    temporary="$(mktemp "${destination}.tmp.XXXXXX")"
    POLICY_READ_COUNT="${#READ_TOOLS[@]}" POLICY_WRITE_COUNT="${#WRITE_TOOLS[@]}" \
        "$python" - "$consumer" "$request_uid" "$operator_uid" \
        "$credential_env" "$credential_file" "${READ_TOOLS[@]}" "${WRITE_TOOLS[@]}" "$@" \
        > "$temporary" <<'PY'
import json
import os
import sys

consumer, request_uid, operator_uid, credential_env, credential_file = sys.argv[1:6]
read_count = int(os.environ["POLICY_READ_COUNT"])
write_count = int(os.environ["POLICY_WRITE_COUNT"])
tail = sys.argv[6:]
read_tools = tail[:read_count]
write_tools = tail[read_count : read_count + write_count]
upstream = tail[read_count + write_count :]
json.dump(
    {
        "consumer": consumer,
        "request_uid": int(request_uid),
        "operator_uid": int(operator_uid),
        "upstream": {
            "argv": upstream,
            "credential_env": credential_env,
            "credential_file": credential_file,
        },
        "tools": {"read": read_tools, "write": write_tools},
    },
    sys.stdout,
    indent=2,
)
print()
PY
    install -m 0600 "$temporary" "$destination"
    rm -f "$temporary"
}

render_systemd() {
    local consumer="$1" service_user="$2" home="$3" request_socket="$4"
    local control_socket="$5" policy="$6" python="$7"
    local template="$DOTFILES_DIR/services/agent-secret/agent-secret-broker@.service"
    local unit="$DESTDIR/etc/systemd/system/dotfiles-agent-secret@.service"
    install -d -m 0755 "${unit%/*}"
    sed \
        -e "s|__PYTHON__|$python|g" \
        -e 's|__LIBEXEC__|/usr/local/libexec/dotfiles|g' \
        -e "s|__POLICY__|$policy|g" \
        -e "s|__REQUEST_SOCKET__|$request_socket|g" \
        -e "s|__CONTROL_SOCKET__|$control_socket|g" \
        -e "s|__SERVICE_USER__|$service_user|g" \
        -e "s|__STATE_DIR__|$home|g" \
        "$template" > "$unit"
    chmod 0644 "$unit"
    [[ -n "$DESTDIR" ]] && return
    systemctl daemon-reload
    systemctl enable "dotfiles-agent-secret@$consumer.service"
    systemctl restart "dotfiles-agent-secret@$consumer.service"
}

render_launchd() {
    local consumer="$1" service_user="$2" home="$3" request_socket="$4"
    local control_socket="$5" policy="$6" python="$7"
    local template="$DOTFILES_DIR/services/agent-secret/com.dotfiles.agent-secret.plist"
    local plist="$DESTDIR/Library/LaunchDaemons/com.dotfiles.agent-secret.$consumer.plist"
    install -d -m 0755 "${plist%/*}"
    sed \
        -e "s|__CONSUMER__|$consumer|g" \
        -e "s|__PYTHON__|$python|g" \
        -e 's|__LIBEXEC__|/usr/local/libexec/dotfiles|g' \
        -e "s|__POLICY__|$policy|g" \
        -e "s|__REQUEST_SOCKET__|$request_socket|g" \
        -e "s|__CONTROL_SOCKET__|$control_socket|g" \
        -e "s|__SERVICE_USER__|$service_user|g" \
        -e "s|__STATE_DIR__|$home|g" \
        "$template" > "$plist"
    chmod 0644 "$plist"
    [[ -n "$DESTDIR" ]] && return
    launchctl bootout "system/com.dotfiles.agent-secret.$consumer" >/dev/null 2>&1 || true
    launchctl bootstrap system "$plist"
}

install_consumer() {
    local consumer="$1" credential_env="$2" credential_file="$3"
    local request_user="$4" operator_user="$5"
    shift 5
    local platform service_user request_uid operator_uid policy_dir policy
    local credential_dir credential_source socket_dir request_socket control_socket home python executable
    local state_root
    validate_consumer "$consumer"
    [[ "$credential_env" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid credential environment name"
    ((${#READ_TOOLS[@]} + ${#WRITE_TOOLS[@]} > 0)) || die "at least one tool must be allowed"
    request_uid="$(resolve_uid "$request_user")"
    operator_uid="$(resolve_uid "$operator_user")"
    [[ "$request_uid" != "$operator_uid" ]] || die "request and operator users must be distinct"
    credential_source="$credential_file"
    if [[ -n "$DESTDIR" && ! -e "$credential_source" && -e "$DESTDIR$credential_source" ]]; then
        credential_source="$DESTDIR$credential_source"
    fi
    credential_is_private "$credential_source"
    (($# > 0)) || die "missing upstream command"
    executable="$1"
    [[ "$executable" == /* && "$executable" != *'/../'* ]] || die "upstream executable must be an absolute path"
    [[ -n "$DESTDIR" || -x "$executable" ]] || die "upstream executable is not executable: $executable"
    trusted_executable "$executable" "upstream executable"

    service_user="agent-secret-$consumer"
    case "$(uname -s)" in
        Linux)
            platform=linux
            socket_dir=/var/run/dotfiles-agent-secrets
            state_root=/var/lib/dotfiles-agent-secrets
            ;;
        Darwin)
            platform=macos
            socket_dir=/var/run/dotfiles-agent-secrets
            state_root=/var/db/dotfiles-agent-secrets
            ;;
        *) die "unsupported platform" ;;
    esac
    home="$state_root/$consumer"
    request_socket="$socket_dir/$consumer.sock"
    control_socket="$socket_dir/$consumer.control.sock"
    policy_dir=/etc/dotfiles/agent-secret-broker
    credential_dir=/etc/dotfiles/agent-secret/credentials
    policy="$policy_dir/$consumer.json"
    python="$(python_path)"
    trusted_executable "$python" "python interpreter"

    ensure_identity "$platform" "$service_user" "$home"
    if [[ -n "$DESTDIR" ]]; then
        install -d -m 0700 "$DESTDIR$policy_dir" "$DESTDIR$credential_dir"
        install -d -m 0755 "$DESTDIR$socket_dir"
    else
        install -d -m 0700 -o root -g 0 "$policy_dir" "$credential_dir"
        install -d -m 0755 -o root -g 0 "$socket_dir"
    fi
    ensure_service_home "$service_user" "$home"
    copy_runtime_tools
    render_policy "$DESTDIR$policy" "$consumer" "$request_uid" "$operator_uid" \
        "$credential_env" "$credential_file" "$@"

    case "$platform" in
        # One systemd template file backs every instance, so it must be rendered
        # instance-generic: %i resolves to the consumer at start time. Baking a
        # single consumer's paths in makes the last install win for all of them.
        linux)
            render_systemd "$consumer" "agent-secret-%i" "$state_root/%i" \
                "$socket_dir/%i.sock" "$socket_dir/%i.control.sock" \
                "$policy_dir/%i.json" "$python"
            ;;
        macos) render_launchd "$consumer" "$service_user" "$home" "$request_socket" "$control_socket" "$policy" "$python" ;;
    esac
}

remove_consumer() {
    local consumer="$1" policy_dir=/etc/dotfiles/agent-secret-broker
    local socket_dir=/var/run/dotfiles-agent-secrets
    validate_consumer "$consumer"
    case "$(uname -s)" in
        Linux)
            if [[ -z "$DESTDIR" ]]; then
                systemctl disable --now "dotfiles-agent-secret@$consumer.service" >/dev/null 2>&1 || true
            fi
            ;;
        Darwin)
            if [[ -z "$DESTDIR" ]]; then
                launchctl bootout "system/com.dotfiles.agent-secret.$consumer" >/dev/null 2>&1 || true
            fi
            rm -f "$DESTDIR/Library/LaunchDaemons/com.dotfiles.agent-secret.$consumer.plist"
            ;;
        *) die "unsupported platform" ;;
    esac
    rm -f "$DESTDIR$policy_dir/$consumer.json"
    rm -f "$DESTDIR$socket_dir/$consumer.sock" "$DESTDIR$socket_dir/$consumer.control.sock"
}

require_root
(($# >= 2)) || { usage; exit 2; }
action="$1"
consumer="$2"
shift 2

case "$action" in
    install)
        credential_env=""
        credential_file=""
        request_user=""
        operator_user=root
        while (($#)); do
            case "$1" in
                --credential-env) shift; credential_env="${1:-}" ;;
                --credential-file) shift; credential_file="${1:-}" ;;
                --request-user) shift; request_user="${1:-}" ;;
                --operator-user) shift; operator_user="${1:-}" ;;
                --read-tool) shift; READ_TOOLS+=("${1:-}") ;;
                --write-tool) shift; WRITE_TOOLS+=("${1:-}") ;;
                --) shift; break ;;
                *) die "unknown option: $1" ;;
            esac
            shift
        done
        [[ -n "$credential_env" && -n "$credential_file" && -n "$request_user" ]] || die "missing install option"
        for tool in "${READ_TOOLS[@]}" "${WRITE_TOOLS[@]}"; do
            validate_tool "$tool"
        done
        for read_tool in "${READ_TOOLS[@]}"; do
            for write_tool in "${WRITE_TOOLS[@]}"; do
                [[ "$read_tool" != "$write_tool" ]] || die "tool cannot be both read and write: $read_tool"
            done
        done
        install_consumer "$consumer" "$credential_env" "$credential_file" \
            "$request_user" "$operator_user" "$@"
        ;;
    remove)
        (($# == 0)) || die "remove takes only a consumer"
        remove_consumer "$consumer"
        ;;
    *) usage; exit 2 ;;
esac

{{- /*
Renders ~/.copilot/mcp-config.json with fixed secretless proxy commands.
The proxy socket is the only credential-bearing boundary; this template never
reads or emits API-key, PAT, env, or envFile values.
*/ -}}

{
  "mcpServers": {
    "context7": {
      "type": "local",
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": [
        "--socket",
        "/var/run/dotfiles-agent-secrets/context7.sock"
      ],
      "tools": [
        "*"
      ]
    },

    "tavily": {
      "type": "local",
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": [
        "--socket",
        "/var/run/dotfiles-agent-secrets/tavily.sock"
      ],
      "tools": [
        "*"
      ]
    },

    "tilth": {
      "type": "local",
      "command": "tilth",
      "args": [
        "--mcp",
        "--edit"
      ],
      "tools": [
        "*"
      ]
    },
    "hallouminate": {
      "type": "local",
      "command": "hallouminate",
      "args": [
        "serve"
      ],
      "tools": [
        "*"
      ]
    }
  }
}

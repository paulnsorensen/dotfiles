#!/bin/bash
# run_onchange — re-runs whenever the shared agents-doc files change.
#
# Reruns when the contents of agents/AGENTS.md or the shared Sliced Bread
# reference change. The hash below is computed by chezmoi at template render
# time over the rendered script; chezmoi reruns whenever the embedded hash
# changes.
#
# Agents-doc hash: {{ output "sh" "-c" (printf "shasum -a 256 %q/../agents/AGENTS.md %q/../agents/reference/sliced-bread.md 2>/dev/null | shasum -a 256 | cut -d' ' -f1" .chezmoi.sourceDir .chezmoi.sourceDir) }}

set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
DOTFILES_ROOT="$SOURCE_DIR/.."
INSTALLER="$SOURCE_DIR/lib/install-agents-doc.sh"

# Shared global preferences → every harness's instructions file
"$INSTALLER" "$DOTFILES_ROOT/agents/AGENTS.md" \
    "$HOME/.claude/CLAUDE.md" \
    "$HOME/.codex/AGENTS.md" \
    "$HOME/.pi/agent/AGENTS.md" \
    "$HOME/.config/opencode/AGENTS.md" \
    "$HOME/.gemini/config/AGENTS.md"

# T3 Code links ~/.gemini/AGENTS.md (not ~/.gemini/config/AGENTS.md) into its
# isolated Antigravity ACP profile. Pointing ~/.gemini/AGENTS.md at
# config/AGENTS.md satisfies T3 while letting standalone agy deduplicate both
# paths by resolved file path instead of loading global rules twice.
# No other source manages ~/.gemini/AGENTS.md, so a regular file there with
# different content is the user's own. Keep it as a timestamped backup.
gemini_agents="$HOME/.gemini/AGENTS.md"
if [[ -d "$gemini_agents" && ! -L "$gemini_agents" ]]; then
    echo "install-agents-doc: refusing to replace directory $gemini_agents" >&2
    exit 1
fi
if [[ -f "$gemini_agents" && ! -L "$gemini_agents" ]] \
    && ! cmp -s "$gemini_agents" "$HOME/.gemini/config/AGENTS.md"; then
    backup="$gemini_agents.bak.$(date +%Y%m%d%H%M%S)"
    mv -- "$gemini_agents" "$backup"
    echo "install-agents-doc: moved $gemini_agents to $backup" >&2
fi
ln -sfn config/AGENTS.md "$gemini_agents"

# Shared architecture reference → harness-neutral location
"$INSTALLER" "$DOTFILES_ROOT/agents/reference/sliced-bread.md" \
    "$HOME/.agents/reference/sliced-bread.md"

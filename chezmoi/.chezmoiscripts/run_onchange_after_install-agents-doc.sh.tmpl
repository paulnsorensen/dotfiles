#!/bin/bash
# run_onchange — re-runs whenever the shared agents-doc files change.
#
# Reruns when the contents of agents/AGENTS.md, agents/RTK.md, or the shared
# Sliced Bread reference change. The hash below is computed by chezmoi at
# template render time over the rendered script; chezmoi reruns whenever the
# embedded hash changes.
#
# Agents-doc hash: {{ output "sh" "-c" (printf "shasum -a 256 %q/../agents/AGENTS.md %q/../agents/RTK.md %q/../agents/reference/sliced-bread.md 2>/dev/null | shasum -a 256 | cut -d' ' -f1" .chezmoi.sourceDir .chezmoi.sourceDir .chezmoi.sourceDir) }}

set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
DOTFILES_ROOT="$SOURCE_DIR/.."
INSTALLER="$SOURCE_DIR/lib/install-agents-doc.sh"

# Shared global preferences → each harness that consumes the global agents doc
"$INSTALLER" "$DOTFILES_ROOT/agents/AGENTS.md" \
    "$HOME/.claude/CLAUDE.md" \
    "$HOME/.codex/AGENTS.md" \
    "$HOME/.pi/agent/AGENTS.md"

# Shared architecture reference → harness-neutral location
"$INSTALLER" "$DOTFILES_ROOT/agents/reference/sliced-bread.md" \
    "$HOME/.agents/reference/sliced-bread.md"

# RTK is Claude-specific because its rewrite hook lives there. The `@RTK.md`
# import remains benign literal text for Codex and Pi.
"$INSTALLER" "$DOTFILES_ROOT/agents/RTK.md" \
    "$HOME/.claude/RTK.md"

#!/bin/bash
# run_onchange — reload systemd user units for the optional local-LLM stack.
# The body collapses to a no-op when `.localLLM` is false.
#
# Hash the systemd units so edits retrigger daemon-reload.
# sources hash: {{ output "sh" "-c" (printf "cat %q/dot_config/systemd/user/*.service %q/dot_config/systemd/user/*.target 2>/dev/null | shasum -a 256 | cut -d' ' -f1" .chezmoi.sourceDir .chezmoi.sourceDir) }}

set -euo pipefail
{{/* `get` (not bare `.localLLM`): chezmoi renders with missingkey=error, so a
     bare reference fails `chezmoi apply` on any machine whose chezmoi.toml
     predates this flag. `get . "localLLM"` returns "" (falsy → no-op) when absent. */}}
{{ if (get . "localLLM") }}

# Pick up newly-deployed ~/.config/systemd/user units. daemon-reload ONLY —
# enabling/starting the stack stays explicit (llm-up), since a flag-on machine
# may not yet have the 85G models or the built llama.cpp/llama-swap binaries.
if command -v systemctl &>/dev/null; then
    # Retired in #288/#289 (always-on workers → llama-swap; opus → cloud).
    # .chezmoiremove deletes the deployed unit files; stop/disable/mask here so
    # a still-running stale copy can't linger or restart. The mask symlinks land
    # at the same target paths, so the next apply's .chezmoiremove sweeps them
    # too — by then the real unit files are long gone.
    for unit in worker-igpu worker-cpu worker-coder worker-vision worker-opus; do
        systemctl --user stop "$unit" 2>/dev/null || true
        systemctl --user disable "$unit" 2>/dev/null || true
        systemctl --user mask "$unit" 2>/dev/null || true
    done
    if ! systemctl --user daemon-reload; then
        echo "⚠ systemctl --user daemon-reload failed — newly-deployed units may be stale. Re-run 'systemctl --user daemon-reload' once a user session/bus is available." >&2
    fi
fi
{{ end }}

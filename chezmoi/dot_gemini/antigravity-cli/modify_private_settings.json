#!/bin/sh
# Author Antigravity CLI settings from .chezmoidata/agy.yaml.
#
# Keys listed in lib/agy-settings-ignore.txt (such as trustedWorkspaces and
# model) keep their live values without a warning. Keys listed in
# lib/agy-settings-retired.txt are deleted from the live file before the gate
# runs, so a retired key never survives as drift. Other unknown live keys keep
# their live values with a warning (lib/drift-gate.sh); they never halt
# `chezmoi apply`. Fold each reported key into the registry.

set -eu

registry=${CHEZMOI_SOURCE_DIR:?CHEZMOI_SOURCE_DIR is unset}/.chezmoidata/agy.yaml
ignore=$CHEZMOI_SOURCE_DIR/lib/agy-settings-ignore.txt
retired=$CHEZMOI_SOURCE_DIR/lib/agy-settings-retired.txt
gate=$CHEZMOI_SOURCE_DIR/lib/drift-gate.sh
live=$(cat)

for tool in yq jq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "modify_settings.json: $tool missing; Antigravity settings are unchanged" >&2
        printf '%s' "$live"
        exit 0
    fi
done

if [ ! -f "$registry" ]; then
    echo "modify_settings.json: registry missing: $registry" >&2
    exit 1
fi

desired=$(yq -o=json '.agy.settings' "$registry" \
    | jq --arg home "${HOME:-}" 'walk(if type == "string" then gsub("\\$\\{HOME\\}"; $home) else . end)')
if ! printf '%s' "$desired" | jq -e 'type == "object"' >/dev/null 2>&1; then
    echo "modify_settings.json: agy.settings must be a map" >&2
    exit 1
fi

if [ ! -f "$gate" ]; then
    echo "modify_settings.json: source missing: $gate" >&2
    exit 1
fi
# shellcheck source=../../lib/drift-gate.sh
. "$gate"

if [ -z "$(printf '%s' "$live" | tr -d '[:space:]')" ]; then
    drift_clear_state agy-settings
    printf '%s\n' "$desired"
    exit 0
fi

live_json=$(printf '%s' "$live" | jq '.' 2>/dev/null) || live_json=
if [ -z "$live_json" ] || ! printf '%s' "$live_json" | jq -e 'type == "object"' >/dev/null 2>&1; then
    echo "modify_settings.json: live settings are not a JSON object" >&2
    exit 1
fi

retired_paths=$(drift_ignore_paths "$retired")
live_json=$(printf '%s' "$live_json" | jq --argjson r "$retired_paths" 'delpaths($r)')

ignore_paths=$(drift_ignore_paths "$ignore")
unknown=$(drift_unknown "$live_json" "$desired" "$ignore_paths")
result=$(drift_preserve "$live_json" "$desired" "$unknown")
desired=$(printf '%s' "$result" | jq '.doc')
drift_report agy-settings "Antigravity settings.json" "$result" "$registry" "$ignore"
desired=$(drift_overlay_ignored "$live_json" "$desired" "$ignore_paths")

printf '%s\n' "$desired"

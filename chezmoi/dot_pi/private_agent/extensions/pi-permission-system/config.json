{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.env.dist": "allow",
      "*.env.defaults": "allow",
      "**/.netrc": "deny",
      "**/_netrc": "deny",
      "**/.pgpass": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.git-credentials": "deny",
      "**/.htpasswd": "deny",
      "**/kubeconfig": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.keystore": "deny",
      "**/*.jks": "deny",
      "**/*.ppk": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/secret.json": "deny",
      "**/secret.toml": "deny",
      "**/secret.env": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secrets.json": "deny",
      "**/secrets.toml": "deny",
      "**/secrets.env": "deny",
      "**/*.secret": "deny",
      "~/.aws/credentials": "deny",
      "~/.gnupg/*": "deny",
      "~/.ssh/*": "deny",
      "~/.ssh/*.pub": "allow",
      "~/.ssh/known_hosts": "allow",
      "~/.ssh/config": "allow",
      "~/.ssh/authorized_keys": "allow"
    }
  }
}

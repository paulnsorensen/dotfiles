{
  "mcpServers": {
    "tilth": {
      "command": "tilth",
      "args": ["--mcp", "--edit"],
      "description": "Structural code search, reads, and tagged edits",
      "toolExposure": {
        "tilth_search": "direct",
        "tilth_read": "direct",
        "tilth_write": "direct"
      }
    },
    "context7": {
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": ["--socket", "/var/run/dotfiles-agent-secrets/context7.sock"]
    },
    "tavily": {
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": ["--socket", "/var/run/dotfiles-agent-secrets/tavily.sock"]
    },
{{ if eq (env "MILKNADO_ENABLED") "true" }}    "milknado": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/paulnsorensen/milknado@main", "milknado-mcp"]
    },
{{ end }}
    "hallouminate": {
      "command": "hallouminate",
      "args": ["serve"]
    }
  }
}

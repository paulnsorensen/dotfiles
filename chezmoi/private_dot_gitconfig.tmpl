[user]
	name = Paul Sorensen
	email = {{ .email }}

[core]
    attributesfile = ~/.gitattributes
[branch]
  autosetuprebase = always

[fetch]
	prune = true

[push]
  default = simple

[commit]
	verbose = true

[color]
  ui = true
[color "diff"]
	meta = 246      # dim (#939393)
	func = 140      # magenta (#b287cd)
	old = 167       # red (#eb6b6f)
	new = 108       # green (#88b994)
	frag = 140      # magenta (#b287cd)
[color "status"]
	added = 108     # green (#88b994)
	untracked = 167 # red (#eb6b6f)
	nobranch = bold 167
	changed = 214   # yellow (#ffae00)
[color "interactive"]
	prompt = 103    # blue (#8196a8)

[alias]
	cpersonal = !git config user.email paulnsorensen@gmail.com

[difftool "kdiff3"]
    trustExitCode = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[difftool]
    prompt = false
[diff]
    tool = kdiff3
[mergetool "kdiff3"]
    trustExitCode = false
[mergetool]
    keepBackup = false
[merge]
    tool = kdiff3
    conflictstyle = zdiff3
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git "%O" "%A" "%B" -s "%S" -x "%X" -y "%Y" -p "%P"

[http "https://gopkg.in"]
	followRedirects = true
[rerere]
	enabled = true
[include]
  path = .gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color "branch"]
	current = 45    # cyan (#00c4fb)
	local = 103     # blue (#8196a8)
	remote = 108    # green (#88b994)
[init]
	defaultBranch = main

[pager]
	diff = delta
	log = delta
	blame = delta
	show = delta

[interactive]
	diffFilter = delta --color-only --features=interactive

[delta]
	navigate = true
	line-numbers = true
	light = false
	features = chocolate-donut

[delta "chocolate-donut"]
	# Diff backgrounds: theme bg #2a1c12 blended with red/green
	minus-style = syntax "#3d2219"
	minus-emph-style = syntax "#5a2b24"
	plus-style = syntax "#2d3520"
	plus-emph-style = syntax "#364428"
	# Line numbers
	line-numbers-minus-style = "#eb6b6f"
	line-numbers-plus-style = "#88b994"
	line-numbers-zero-style = "#939393"
	# Decorations
	commit-decoration-style = "#ffae00" box ul
	file-style = "#ffae00" ul
	file-decoration-style = none
	hunk-header-decoration-style = "#8196a8" box
	hunk-header-style = file line-number "#8196a8"
	hunk-header-file-style = "#ffae00"
	hunk-header-line-number-style = "#8196a8"

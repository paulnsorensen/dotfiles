[user]
	name = Paul Sorensen
	email = {{ .email }}

[core]
    attributesfile = ~/.gitattributes
[branch]
  autosetuprebase = always

[fetch]
	prune = true

[push]
  default = simple

[commit]
	verbose = true

[color]
  ui = true
[color "diff"]
	meta = 245      # dim (#8b8b8b)
	func = 170      # magenta (#d36bd1)
	old = 138       # red (#b69599)
	new = 148       # green (#a1cb2d)
	frag = 170      # magenta (#d36bd1)
[color "status"]
	added = 148     # green (#a1cb2d)
	untracked = 138 # red (#b69599)
	nobranch = bold 138
	changed = 220   # yellow (#f5d710)
[color "interactive"]
	prompt = 105    # blue (#799af9)

[alias]
	cpersonal = !git config user.email paulnsorensen@gmail.com

[difftool "kdiff3"]
    trustExitCode = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[difftool]
    prompt = false
[diff]
    tool = kdiff3
[mergetool "kdiff3"]
    trustExitCode = false
[mergetool]
    keepBackup = false
[merge]
    tool = kdiff3
    conflictstyle = zdiff3
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git "%O" "%A" "%B" -s "%S" -x "%X" -y "%Y" -p "%P"

[http "https://gopkg.in"]
	followRedirects = true
# GitHub HTTPS auth goes through the gh CLI login (`gh auth login`).
# The empty helper clears inherited helpers (e.g. osxkeychain).
# `gh` resolves on PATH because its install path differs per machine.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[rerere]
	enabled = true
[include]
  path = .gitconfig.local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color "branch"]
	current = 109   # cyan (#99bec2)
	local = 105     # blue (#799af9)
	remote = 148    # green (#a1cb2d)
[init]
	defaultBranch = main

[pager]
	diff = delta
	log = delta
	blame = delta
	show = delta

[interactive]
	diffFilter = delta --color-only --features=interactive

[delta]
	navigate = true
	line-numbers = true
	light = false
	features = chocolate-donut

[delta "chocolate-donut"]
	# Diff backgrounds: theme bg #211a16 blended with red/green
	minus-style = syntax "#3f3330"
	minus-emph-style = syntax "#554544"
	plus-style = syntax "#3b3d1b"
	plus-emph-style = syntax "#4e581e"
	# Line numbers
	line-numbers-minus-style = "#b69599"
	line-numbers-plus-style = "#a1cb2d"
	line-numbers-zero-style = "#8b8b8b"
	# Decorations
	commit-decoration-style = "#f5d710" box ul
	file-style = "#f5d710" ul
	file-decoration-style = none
	hunk-header-decoration-style = "#799af9" box
	hunk-header-style = file line-number "#799af9"
	hunk-header-file-style = "#f5d710"
	hunk-header-line-number-style = "#799af9"

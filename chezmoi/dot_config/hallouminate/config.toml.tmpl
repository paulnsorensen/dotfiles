# The shared cheez-wiki knowledge base is readable from every project.
# Keep it as a flat corpus to avoid collisions with repository-layer names.
[[corpus]]
name = "cheez-wiki"
paths = ["~/Dev/cheez-wiki"]
globs = ["**/*.md"]
exclude = ["**/.git/**"]

# Sibling-repo wikis remain stat-guarded per machine so missing optional clones
# cannot abort an index run. Flat corpora avoid collisions with each repository's
# repo-layer config, which derives `repo:<name>:wiki`.
{{ range $repo := list "milknado" "tilth" "hallouminate" "algorhythm" -}}
{{ if stat (joinPath $.chezmoi.homeDir "Dev" $repo ".hallouminate" "wiki") -}}
[[corpus]]
name = "{{ $repo }}-wiki"
paths = ["~/Dev/{{ $repo }}/.hallouminate/wiki"]
globs = ["**/*.md"]
exclude = ["**/.git/**"]

{{ end -}}
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir "Dropbox (Maestral)" "0-Workspace" "_meta") -}}
# Todoist/workspace "constitution" — the _meta folder under the Maestral-synced
# PARA vault. Machine-readable SOT (project_config.yaml) + agent prompts that the
# planned n8n inbox-triage classifier reads (see crabbot wiki todoist-taxonomy-
# sources.md). Stat-guarded: Maestral isn't always mounted, and a missing corpus
# path aborts the whole index run (hallouminate#101). md-only: hallouminate's
# format registry has no YAML handler (format.rs format_from_extension), so
# project_config.yaml is skipped — its vocabulary is already documented in prose
# in system_base.md, which IS groundable. To ground the raw config later, symlink
# it to a .txt (PlainText handler) rather than widening the glob to inert *.yaml.
[[corpus]]
name = "todoist-meta"
paths = ["~/Dropbox (Maestral)/0-Workspace/_meta"]
globs = ["**/*.md"]
exclude = ["**/.git/**"]

{{ end -}}
# Top-level embeddings default for all repos (per-repo config can override).
# snowflake-arctic-embed-s: 384-dim, English, retrieval-tuned. Full precision
# (quantized=false) — corpora are small, so keep max quality.
# NOTE: switching model later requires deleting the shared ground_dir and
# re-running `hallouminate index`.
[embeddings]
enabled = true
model = "snowflake/snowflake-arctic-embed-s"
quantized = false

# Maintenance-debt backpressure thresholds. The defaults (soft 100 / hard 500
# fragments) are tuned for a single small corpus; this baseline aggregates ~9
# corpora, so the store legitimately holds 500+ well-packed LanceDB fragments
# that compaction cannot merge further. At the default hard=500 the daemon
# wedges in permanent `debt: Hard` and blocks EVERY mutation daemon-wide (all
# wiki writes, boot catch-up, index) with no self-clearing path. Raise the
# ceiling to give the multi-corpus store real headroom. Upstream fix owed:
# fragment count is a poor debt proxy for full fragments (see lance.rs debt()).
[daemon]
debt_soft_fragments = 1000
debt_hard_fragments = 3000

// Managed by chezmoi — source: chezmoi/dot_config/zed/settings.json.tmpl
// Codex has registry and pinned custom ACP entries; OMP exposes ACP as `omp acp`.
// Authentication stays in each agent's native configuration, never here.
// Dark theme is the generated dotfiles theme; light falls back to Modus (install its Zed extension).
// Vim keybindings mirror vimrc: scrolloff=5, system clipboard, smartcase f/t motions.
// Zed formats on save via each language's LSP/formatter; prek remains the commit-time
// backstop for final newline + trailing whitespace. Shell + Markdown opt out of format-on-save.
// context_servers wire the MCP roster to Zed's native Agent Panel; secret-bearing servers
// reuse the shared per-service agent-secret-proxy sockets (no plaintext, no new broker).
{
  // Telemetry opt-out folded in from live drift so chezmoi stops re-adding it each sync.
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "theme": {
    "dark": "Chocolate Donut",
    "light": "Modus Operandi Deuteranopia",
    "mode": "system"
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 5,
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",
  "formatter": "language_server",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "soft_wrap": "none",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_fallbacks": ["Hack Nerd Font Mono"],
  "buffer_font_size": 14,
  "languages": {
    "Python": {
      // ruff is the repo's Python formatter (on PATH via mise); the language server handles types.
      "formatter": {
        "external": { "command": "ruff", "arguments": ["format", "-"] }
      },
      "format_on_save": "on"
    },
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "Shell Script": {
      // No shfmt wired; leave shell untouched on save (prek handles whitespace).
      "format_on_save": "off"
    },
    "Markdown": {
      // Don't reflow prose / wiki pages.
      "format_on_save": "off"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" }
      }
    }
  },
  "context_servers": {
    "tilth": {
      "source": "custom",
      "command": "tilth",
      "args": ["--mcp", "--edit", "--search-surface", "both"],
      "env": {}
    },
    "context7": {
      "source": "custom",
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": ["--socket", "/var/run/dotfiles-agent-secrets/context7.sock"],
      "env": {}
    },
    "tavily": {
      "source": "custom",
      "command": "/usr/local/libexec/dotfiles/agent-secret-proxy",
      "args": ["--socket", "/var/run/dotfiles-agent-secrets/tavily.sock"],
      "env": {}
    },
    "hallouminate": {
      "source": "custom",
      "command": "hallouminate",
      "args": ["serve"],
      "env": {}
    },
    "milknado": {
      "source": "custom",
      "command": "milknado-mcp",
      "args": [],
      "env": {}
    }
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true
      },
      "type": "registry"
    },
    "Codex": {
      "type": "custom",
      "command": {{ (or (lookPath "codex-acp") "codex-acp") | quote }},
      "args": [],
      "env": {}
    },
    "OMP": {
      // Pin OMP's ACP model to modelRoles.strong (see chezmoi/.chezmoidata/omp.yaml).
      "default_config_options": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "type": "custom",
      "command": {{ (or (lookPath "omp") "omp") | quote }},
      "args": ["acp"],
      "env": {}
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left",
    "default_width": 260,
    "starts_open": true,
    "entry_spacing": "standard",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "sticky_scroll": true,
    "sort_mode": "directories_first"
  },
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 520
  },
  "terminal": {
    "dock": "bottom",
    "default_height": 280,
    "starts_open": false,
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14
  },
  "bottom_dock_layout": "contained"
}
